@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<!-- Hero Landing page. First section with my logo and my techniques -->
<section class="hero-landing">
    <div class="hero-landing__content">
        @* Decorative: the name is written as real text right below (it used to be part of the image,
           which made it disappear in the light theme) *@
        <img src="~/images/vj-logo.webp" alt="" width="960" height="665" class="hero-landing__logo" />
        <h1 class="hero-landing__name">@Model.Name</h1>
        <p class="hero-landing__tagline">@Model.Role | @string.Join(" | ", Model.Technologies)</p>
        <div class="hero-landing__divider"></div>
    </div>
    <a href="#featured-projects" class="hero-landing__scroll" aria-label="Scroll to my projects">
        <i class="bi bi-chevron-down" aria-hidden="true"></i>
    </a>
</section>
<!-- Second part of page with my flipping project cards-->
<section id="featured-projects" class="py-5">
    <div class="text-center mb-5">
        <h2 class="display-6">My Projects</h2>
    </div>
    <div class="d-flex flex-wrap justify-content-center gap-4 mb-5">
        @foreach (var project in Model.Projects)
        {
            <partial name="_ProjectCard" model="project" />
        }
    </div>
</section>