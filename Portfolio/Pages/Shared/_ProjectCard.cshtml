@model Portfolio.Models.Project
<div class="card-shell">
	<div class="card">
		@if (!string.IsNullOrEmpty(Model.ImageUrl))
		{
			<img src="@Model.PreviewUrl" alt="@Model.Title förhandsvisning" class="card__image" />
		}
		else
		{
			<div class="showcase-card__logo-placeholder">@Model.Title.Substring(0, 1)</div>
		}
			<div class="card__content">
				<h3 class="card__title">@Model.Title</h3>
				<p class="card__description">@Model.Description</p>
				<div class="project_technologies">
					<strong>Technologies:</strong>
					@foreach (var technology in Model.Technologies)
					{
						<span class="technology">@technology</span>
					}
				</div>
				<div class="project_links">
					@if (Model.LiveDemoUrl is not null)
					{
						<a href="@Model.LiveDemoUrl.AbsoluteUri"
						target="_blank"
						rel="noopener noreferrer"
						class="card__button">
						Live Demo
						</a>
					}		
					@if (Model.GitHubUrl is not null)
					{
						<a href="@Model.GitHubUrl.AbsoluteUri"
						target="_blank"
						rel="noopener noreferrer"
						class="card__button secondary">
						Source Code
						</a>
						}
				</div>
			</div>
	</div>
</div>