<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/svg+xml" href="/images/vj-logo.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portfolio</title>
    <script type="importmap"></script>

    <!-- Bootstrap Icons (used for social links, back-to-top arrow, etc.) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />

    <!-- Bootstrap framework -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site-wide custom styles (theme colors, cards, hero, footer, etc.) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Auto-generated CSS isolation bundle (scoped styles from *.cshtml.css files) -->
    <link rel="stylesheet" href="~/Portfolio.styles.css" asp-append-version="true" />

    <!-- Google Fonts: Inter (body text) and JetBrains Mono (nav, tagline, tags).
         Set as CSS variables in site.css: --font-body and --font-mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
    @{
        // Current Razor Page route, e.g. "/Projects" - used to mark the active nav link
        var currentPage = ViewContext.RouteData.Values["page"] as string;

        var navItems = new[]
        {
            (Page: "/Index", Label: "home"),
            (Page: "/Projects", Label: "projects"),
            (Page: "/About", Label: "about"),
            (Page: "/Contact", Label: "contact")
        };
    }
    <header>
        <!-- Main navigation bar. id="top" is the scroll target for the
             "back to top" button in the footer. -->
        <nav id="top" class="navbar navbar-expand-lg navbar-toggleable-sm navbar-dark navbar-themed border-bottom box-shadow">
            <div class="container-fluid">
                <!-- Site logo, links back to the homepage -->
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="~/images/vj-logo.png" alt="Victor Jaque logotyp" class="navbar-logo" />
                </a>

                <!-- Hamburger toggle for mobile/collapsed view -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        @* One link per item in navItems. The active page gets the "active" class,
                           aria-current="page" for screen readers, and a "./" prefix
                           (only shown on the active link, see .nav-prefix in site.css).
                           The prefix is aria-hidden so it isn't read out as "dot slash". *@
                        @foreach (var item in navItems)
                        {
                            var isActive = currentPage == item.Page;

                            <li class="nav-item">
                                <a class="nav-link @(isActive ? "active" : null)"
                                   aria-current="@(isActive ? "page" : null)"
                                   asp-area="" asp-page="@item.Page"><span class="nav-prefix" aria-hidden="true">./</span>@item.Label</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main content area. Each Razor Page's markup is injected here via RenderBody(). -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Site footer: copyright/privacy (left), social links (center), back-to-top (right) -->
    <footer class="footer py-5 mt-5">
        <div class="container">
            <div class="row align-items-center">

                <!-- Left: Copyright & Privacy Policy link -->
                <div class="col-md-4 text-center text-md-start mb-3 mb-md-0">
                    <span class="footer-text">&copy; 2026 - Victor Jaque</span>
                    <span class="mx-2 text-muted">|</span>
                    <a class="footer-link" asp-area="" asp-page="/Privacy">Privacy Policy</a>
                </div>

                <!-- Center: Social media links (LinkedIn, GitHub) -->
                <div class="col-md-4 text-center mb-3 mb-md-0">
                    <a href="https://www.linkedin.com/in/victor-jaque-51214720a" target="_blank" class="social-icon-btn mx-2" title="LinkedIn">
                        <i class="bi bi-linkedin"></i>
                    </a>
                    <a href="https://github.com/VictorJaque91" target="_blank" class="social-icon-btn mx-2" title="GitHub">
                        <i class="bi bi-github"></i>
                    </a>
                </div>

                <!-- Right: Back-to-top button, scrolls to the nav's id="top" anchor -->
                <div class="col-md-4 text-center text-md-end">
                    <a href="#top" class="back-to-top-btn" title="Tillbaka till toppen">
                        <i class="bi bi-chevron-up"></i>
                    </a>
                </div>

            </div>
        </div>
    </footer>

    <!-- Scripts: jQuery, Bootstrap JS bundle, site-specific JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
