@page
@model Portfolio.Pages.ProjectsModel
@{
    ViewData["Title"] = "Projects";
}

<div class="text-center mb-5">
    <h1 class="display-4">My Projects</h1>
    <p>A closer look at what I've built and what's coming next.</p>
</div>
@* Filter buttons. Rendered hidden and shown by site.js, so they never appear
   for visitors without JavaScript (where they wouldn't do anything). *@
<div class="project-filter" role="group" aria-label="Filter projects by technology" data-project-filter hidden>
    <button type="button" class="project-filter__button" data-filter="All" aria-pressed="true">All</button>
    @foreach (var technology in Model.Technologies)
    {
        <button type="button" class="project-filter__button" data-filter="@technology" aria-pressed="false">@technology</button>
    }
</div>

@* aria-live: screen readers announce the new count when the filter changes *@
<p class="project-filter__count" data-project-count aria-live="polite" hidden>
    Showing @Model.Projects.Count of @Model.Projects.Count projects
</p>

<!-- Loop to show my showcase cards project which get its data from _ProjectShowcaseCard.cshtml -->
<div class="project-showcase-grid">
   @foreach (var project in Model.Projects)
   {
       <partial name="_ProjectShowcaseCard" model="project" />
   }
</div>