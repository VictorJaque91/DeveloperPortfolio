@page
@model Portfolio.Pages.ProjectsModel
@{
    ViewData["Title"] = "Projects";
}

<div class="text-center mb-5">
    <h1 class="display-4">My Projects</h1>
    <p>A closer look at what I've built and what's coming next.</p>
</div>
<!-- Loop to show my showcase cards project which get its data from _ProjectShowcaseCard.cshtml -->
<div class="project-showcase-grid">
   @foreach (var project in Model.Projects)
   {
       <partial name="_ProjectShowcaseCard" model="project" />
   }
</div>